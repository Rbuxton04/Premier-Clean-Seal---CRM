// Premier Clean & Seal CRM — database schema
// Milestone 0: full domain model in place; features light up milestone by milestone.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & users
// ---------------------------------------------------------------------------

model Organisation {
  id      String @id @default(cuid())
  name    String
  logoUrl String?

  // ----- Business settings (Settings page) -----
  vatRegistered         Boolean @default(false) // Premier C&S: not yet registered
  vatRatePercent        Decimal @default(20) @db.Decimal(5, 2)
  vatNumber             String?
  defaultWarrantyMonths Int     @default(12)
  defaultReminderMonths Int     @default(12)

  // Numbering. Format = literal prefix + run of 0s giving pad width.
  // e.g. "#Q-0000" -> #Q-0001, #Q-0002 ...
  quoteNumberFormat   String @default("#Q-0000")
  invoiceNumberFormat String @default("#I-0000")
  jobNumberFormat     String @default("#J-0000")
  quoteCounter        Int    @default(0)
  invoiceCounter      Int    @default(0)
  jobCounter          Int    @default(0)

  users        User[]
  customers    Customer[]
  enquiries    Enquiry[]
  quotes       Quote[]
  jobs         Job[]
  products     Product[]
  campaigns    Campaign[]
  reminders    MarketingReminder[]
  tags         Tag[]
  auditLogs    AuditLog[]
  permissions  Permission[]
  mediaFiles   MediaFile[]
  insightReports InsightReport[]
  hotelGroups     HotelGroup[]
  hotelProperties HotelProperty[]
  certifications  Certification[]
  takeoffs        Takeoff[]
  scalePresets    ScalePreset[]
  takeoffItemPresets TakeoffItemPreset[]
  takeoffFiles       TakeoffFile[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  ADMIN
  OFFICE
  ESTIMATOR
  TECHNICIAN
  SALES
  READONLY
  // Read-only, finance-scoped: the Finance area + invoice/quote/job
  // financial totals and exports only. See src/lib/permissions.ts and
  // src/app/(crm)/layout.tsx for the server-side route/action enforcement.
  ACCOUNTANT
}

model User {
  id             String  @id @default(cuid())
  clerkId        String? @unique
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  name           String
  email          String  @unique
  // Legacy single-role column -- kept for backward compatibility, mirrored
  // to the highest-priority entry in roles[] on every write (see
  // primaryRole() in user.service.ts). No application logic reads this
  // field anymore; roles[] is the source of truth. See hasRole()/
  // hasAnyRole() in src/lib/permissions.ts.
  role           Role    @default(OFFICE)
  roles          Role[]  @default([])
  active         Boolean @default(true)
  jobsAssigned   Job[]
  enquiries      Enquiry[]
  createdAt      DateTime @default(now())

  // Route planner "finish at home" end point. Geocoded once on save and
  // cached, same GB-constrained pattern as Property lat/lng, so planRoute
  // can use it as a fixed final destination without re-geocoding on every
  // plan. Either the technician themselves or an admin/office user can set
  // this — see setTechnicianHomeAddressAction.
  homeAddress   String?
  homeLatitude  Float?
  homeLongitude Float?

  certifications Certification[]
}

model Permission {
  id             String @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  role           Role
  resource       String
  actions        String[]

  @@unique([organisationId, role, resource])
}

// ---------------------------------------------------------------------------
// Customers & properties
// ---------------------------------------------------------------------------

model Customer {
  id             String  @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  name           String
  company        String?
  phone          String?
  email          String?
  notes          String?
  marketingEmail Boolean @default(false)
  marketingSms   Boolean @default(false)
  consentAt      DateTime?
  totalSpend     Decimal @default(0) @db.Decimal(12, 2)

  properties     Property[]
  enquiries      Enquiry[]
  quotes         Quote[]
  jobs           Job[]
  invoices       Invoice[]
  timeline       TimelineEvent[]
  communications CommunicationLog[]
  reminders      MarketingReminder[]
  portalTokens   PortalToken[]
  mediaFiles     MediaFile[]
  tags           Tag[]           @relation("CustomerTags")
  hotelProperties HotelProperty[]
  takeoffs        Takeoff[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  deletedById  String? // plain scalar (no relation) -- same convention as Job.deletedById
  anonymisedAt DateTime? // set by the GDPR "erase" action; personal fields are scrubbed at that point

  @@index([organisationId, name])
}

model Tag {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  name           String
  colour         String   @default("#3C2263") // hex; shown as a chip
  customers      Customer[] @relation("CustomerTags")
  createdAt      DateTime @default(now())

  @@unique([organisationId, name])
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  HOTEL
  OFFICE
  HOSPITAL
  OTHER
}

model Property {
  id           String  @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  addressLine1 String
  addressLine2 String?
  city         String?
  postcode     String
  propertyType PropertyType @default(RESIDENTIAL)
  notes        String?
  // Cached Mapbox geocode result (Milestone 13 — job map). Set once on first
  // lookup and reused forever unless the address changes, to protect the
  // Mapbox free tier from repeat geocoding on every map load.
  latitude     Float?
  longitude    Float?
  createdAt    DateTime @default(now())
  // Soft delete — mirrors Customer.deletedAt/Job.deletedAt. deletedById is a
  // plain scalar (no relation), same convention as Job.deletedById. Deleting
  // a property never cascades — jobs/enquiries/work-log history referencing
  // it survive untouched, only its own visibility (lists/pickers/maps) is
  // hidden. See src/services/customer.service.ts.
  deletedAt      DateTime?
  deletedById    String?
  jobs         Job[]
  enquiries    Enquiry[]
  workLogEntries PropertyWorkLog[]

  @@index([postcode])
}

// Per-property history of sealant work carried out — independent of the
// (not yet built) Jobs module so repeat-business lookups work today.
// Once Jobs/MaterialUsage are live for scheduled work, this remains the
// durable record of what was actually installed and where.
model PropertyWorkLog {
  id           String            @id @default(cuid())
  propertyId   String
  property     Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  description  String
  productId    String?
  product      Product?          @relation(fields: [productId], references: [id])
  productText  String
  colour       String
  area         ApplicationArea?
  batchNumber  String?
  completedAt  DateTime
  photos       MediaFile[]
  createdAt    DateTime          @default(now())

  @@index([propertyId, completedAt])
}

// ---------------------------------------------------------------------------
// Enquiries & pipeline
// ---------------------------------------------------------------------------

enum WorkType {
  BATHROOM
  KITCHEN
  SHOWER
  EXTERNAL_WINDOWS
  EXPANSION_JOINTS
  FIRE_SEALANT
  CUT_OUT_RESEAL
  NEW_SILICONE
  OTHER
}

enum ContactMethod {
  PHONE
  EMAIL
  SMS
  WHATSAPP
}

enum EnquiryStage {
  NEW
  CONTACTED
  SITE_VISIT_BOOKED
  QUOTED
  WAITING_DECISION
  ACCEPTED
  REJECTED
  BOOKED
  COMPLETED
  FOLLOW_UP
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Enquiry {
  id             String  @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  propertyId     String?
  property       Property? @relation(fields: [propertyId], references: [id])

  // Raw submission (kept verbatim even after linking to a customer)
  name             String
  company          String?
  phone            String
  email            String
  addressText      String
  postcode         String
  propertyType     PropertyType
  workTypes        WorkType[]
  description      String
  preferredContact ContactMethod @default(PHONE)
  preferredDate    DateTime?
  consentGiven     Boolean       @default(false)

  stage          EnquiryStage @default(NEW)
  priority       Priority     @default(NORMAL)
  kanbanOrder    Int          @default(0)
  estimatedValue Decimal?     @db.Decimal(12, 2)
  assignedToId   String?
  assignedTo     User?        @relation(fields: [assignedToId], references: [id])

  files      MediaFile[]
  aiAnalysis AIAnalysis?
  quotes     Quote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId, stage, kanbanOrder])
}

model AIAnalysis {
  id                 String  @id @default(cuid())
  enquiryId          String  @unique
  enquiry            Enquiry @relation(fields: [enquiryId], references: [id])
  findings           Json
  jobSummary         String
  estimatedWork      String
  estimatedMetres    Decimal? @db.Decimal(8, 2)
  suggestedProducts  Json
  suggestedColours   String[]
  suggestedLabourHrs Decimal? @db.Decimal(6, 2)
  quoteNotes         String?
  confidence         Int
  model              String
  editedByUser       Boolean  @default(false)
  createdAt          DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Quotes
// ---------------------------------------------------------------------------

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  APPROVED
  REJECTED
  EXPIRED
}

model Quote {
  id             String      @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  quoteNumber    String      @unique
  customerId     String
  customer       Customer    @relation(fields: [customerId], references: [id])
  enquiryId      String?
  enquiry        Enquiry?    @relation(fields: [enquiryId], references: [id])
  status         QuoteStatus @default(DRAFT)
  scopeOfWorks   String
  subtotal       Decimal     @db.Decimal(12, 2)
  vatApplied     Boolean     @default(false) // snapshot of org VAT status at issue
  vatRatePercent Decimal     @default(0) @db.Decimal(5, 2)
  vatAmount      Decimal     @default(0) @db.Decimal(12, 2)
  total          Decimal     @db.Decimal(12, 2)
  depositAmount  Decimal?    @db.Decimal(12, 2)
  terms          String?
  warrantyMonths Int?
  pdfUrl         String?
  approvalToken  String?     @unique
  approvedAt     DateTime?
  approvedName   String?
  approvedIp     String?
  expiresAt      DateTime?
  lineItems      QuoteLineItem[]
  job            Job?
  takeoffs       Takeoff[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  // Soft delete — mirrors Customer.deletedAt / Job.deletedAt.
  deletedAt      DateTime?
  deletedById    String?
}

model QuoteLineItem {
  id          String  @id @default(cuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unit        String
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0)
}

// ---------------------------------------------------------------------------
// Jobs
// ---------------------------------------------------------------------------

enum JobStatus {
  BOOKED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  DEPOSIT_PAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  REFUNDED
}

model Job {
  id             String    @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  jobNumber      String    @unique
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id])
  propertyId     String?
  property       Property? @relation(fields: [propertyId], references: [id])
  quoteId        String?   @unique
  quote          Quote?    @relation(fields: [quoteId], references: [id])
  technicianId   String?
  technician     User?     @relation(fields: [technicianId], references: [id])

  status         JobStatus     @default(BOOKED)
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  // Milestone: weather layer on the calendar — marks outdoor/silicone-in-
  // the-weather jobs so a rain forecast can be shown more prominently than
  // for jobs where rain doesn't matter. Nullable/defaults unset rather than
  // false so existing jobs aren't implicitly asserted as indoor.
  isExternal     Boolean?
  // Soft delete — mirrors Customer.deletedAt. deletedById is a plain scalar
  // (no relation), same convention as CommunicationLog.userId, to avoid
  // needing a named back-relation array on User.
  deletedAt      DateTime?
  deletedById    String?
  actualStart    DateTime?
  actualEnd      DateTime?

  price          Decimal       @db.Decimal(12, 2)
  depositPaid    Decimal       @default(0) @db.Decimal(12, 2)
  balanceDue     Decimal       @default(0) @db.Decimal(12, 2)
  paymentStatus  PaymentStatus @default(UNPAID)

  notes              String?
  internalNotes      String?
  completionNotes    String?
  metresInstalled    Decimal? @db.Decimal(8, 2)
  customerSignature  String?
  satisfactionRating Int?
  aiReport           Json?

  materials   MaterialUsage[]
  files       MediaFile[]
  warranty    Warranty?
  invoice     Invoice?
  reminders   MarketingReminder[]
  healthScore JobHealthScore?
  timeline    TimelineEvent[]
  roomVisits  RoomVisit[]
  takeoffs    Takeoff[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId, status, scheduledStart])
}

// ---------------------------------------------------------------------------
// Weather (calendar rain warnings) — not org-scoped, purely location/date
// keyed, since the same forecast applies regardless of which org asked for
// it. See src/services/weather.service.ts.
// ---------------------------------------------------------------------------

model WeatherCache {
  id        String   @id @default(cuid())
  // Rounded to 2 decimal places (~1.1km) so job locations a few streets
  // apart share one cache entry/Open-Meteo call instead of each burning
  // their own.
  latitude  Float
  longitude Float
  date      DateTime // day this forecast is for, stored at UTC midnight
  weatherCode                 Int
  temperatureMaxC             Float
  temperatureMinC             Float
  precipitationProbabilityMax Int
  precipitationSumMm          Float
  fetchedAt DateTime @default(now())

  @@unique([latitude, longitude, date])
}

// ---------------------------------------------------------------------------
// Materials
// ---------------------------------------------------------------------------

model Product {
  id             String  @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  manufacturer   String
  name           String
  colour         String
  finish         String?
  attributes     String[] // FIRE_RATED, NEUTRAL_CURE, ACOUSTIC, LMN, SANITARY
  supplier       String?
  unitCost       Decimal? @db.Decimal(10, 2)
  // Optional stock-keeping code / SKU -- free text, no uniqueness enforced
  // (some suppliers don't provide one).
  sku String?

  // Stock/inventory (Materials hub). Decimal, not Int, to match
  // MaterialUsage.quantityUsed's precision -- a delivery or a job can use a
  // fractional number of tubes. stockQuantity is allowed to go negative
  // (see decrementStockForUsage in materials.service.ts) rather than being
  // silently clamped at 0, so an over-use is visible as a flagged negative
  // rather than hidden.
  stockQuantity Decimal @default(0) @db.Decimal(10, 2)
  stockUnit     String  @default("tubes")
  // Null = no low-stock tracking for this product. Compared against
  // stockQuantity in materials.service.ts, not at the DB level (Prisma
  // can't express a cross-column comparison in `where`).
  lowStockThreshold Decimal? @db.Decimal(10, 2)

  usages         MaterialUsage[]
  workLogEntries PropertyWorkLog[]

  // Soft delete -- mirrors Customer.deletedAt / Job.deletedAt. Never
  // cascades: historical MaterialUsage/PropertyWorkLog rows keep their
  // product reference and stay fully readable after a product is retired
  // from the catalogue.
  deletedAt   DateTime?
  deletedById String?

  @@index([organisationId, manufacturer, name, colour])
  @@index([organisationId, deletedAt])
}

enum ApplicationArea {
  INTERNAL
  EXTERNAL
  BATHROOM
  ENSUITE
  KITCHEN
  WINDOW
  EXPANSION_JOINT
}

model MaterialUsage {
  id              String          @id @default(cuid())
  jobId           String
  job             Job             @relation(fields: [jobId], references: [id])
  productId       String
  product         Product         @relation(fields: [productId], references: [id])
  batchNumber     String?
  applicationArea ApplicationArea
  quantityUsed    Decimal         @db.Decimal(10, 2)
  unit            String          @default("tubes")
  cost            Decimal?        @db.Decimal(10, 2)

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Media & documents
// ---------------------------------------------------------------------------

enum MediaKind {
  PHOTO
  VIDEO
  DOCUMENT
  SIGNATURE
}

enum MediaCategory {
  BEFORE
  DURING
  AFTER
  ANNOTATED
  QUOTE_PDF
  INVOICE_PDF
  CERTIFICATE
  RAMS
  RISK_ASSESSMENT
  METHOD_STATEMENT
  INSURANCE
  RECEIPT
  OTHER
}

model MediaFile {
  id             String  @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  jobId          String?
  job            Job? @relation(fields: [jobId], references: [id])
  enquiryId      String?
  enquiry        Enquiry? @relation(fields: [enquiryId], references: [id])
  kind           MediaKind
  category       MediaCategory?
  url            String
  thumbnailUrl   String?
  mimeType       String
  sizeBytes      Int    @default(0)
  pairedWithId   String? // links BEFORE <-> AFTER for sliders
  sharedToPortal Boolean @default(false) // customer portal only shows photos staff have explicitly shared
  uploadedById   String?
  workLogId      String?
  workLog        PropertyWorkLog? @relation(fields: [workLogId], references: [id])
  createdAt      DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Warranty & invoicing
// ---------------------------------------------------------------------------

model Warranty {
  id             String   @id @default(cuid())
  jobId          String   @unique
  job            Job      @relation(fields: [jobId], references: [id])
  startDate      DateTime
  endDate        DateTime
  coverage       String
  certificateUrl String?
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  jobId          String?       @unique
  job            Job?          @relation(fields: [jobId], references: [id])
  subtotal       Decimal       @db.Decimal(12, 2)
  vatApplied     Boolean       @default(false)
  vatRatePercent Decimal       @default(0) @db.Decimal(5, 2)
  vatAmount      Decimal       @default(0) @db.Decimal(12, 2)
  amount         Decimal       @db.Decimal(12, 2)
  status         PaymentStatus @default(UNPAID)
  dueDate        DateTime
  paidAt         DateTime?
  pdfUrl         String?
  createdAt      DateTime      @default(now())
  // Soft delete ("void") — mirrors Customer.deletedAt / Job.deletedAt.
  // Invoices are financial records that must generally be retained (UK:
  // ~6 years), so this hides rather than erases — see the invoice void
  // action in invoice.service.ts.
  deletedAt      DateTime?
  deletedById    String?
}

// ---------------------------------------------------------------------------
// Marketing
// ---------------------------------------------------------------------------

enum Channel {
  EMAIL
  SMS
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  GOOGLE_BUSINESS_PROFILE
}

enum ReminderStatus {
  SCHEDULED
  SENT
  OPENED
  CLICKED
  REPLIED
  CONVERTED
  FAILED
  CANCELLED
  UNSUBSCRIBED
}

model MarketingReminder {
  id             String         @id @default(cuid())
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id])
  customerId     String
  customer       Customer       @relation(fields: [customerId], references: [id])
  jobId          String
  job            Job            @relation(fields: [jobId], references: [id])
  dueDate        DateTime
  intervalMonths Int
  channels       Channel[]
  status         ReminderStatus @default(SCHEDULED)
  sentAt         DateTime?
  messageId      String?
  createdAt      DateTime       @default(now())

  @@index([dueDate, status])
}

model Campaign {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  name           String
  channel        Channel
  content        String
  tone           String?
  aiGenerated    Boolean  @default(false)
  stats          Json?
  createdAt      DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Timeline, comms, audit, health, portal, AI queue
// ---------------------------------------------------------------------------

model TimelineEvent {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  jobId      String?
  job        Job?     @relation(fields: [jobId], references: [id])
  type       String
  title      String
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
}

model CommunicationLog {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  direction  String
  channel    Channel
  subject    String?
  body       String
  userId     String?
  createdAt  DateTime @default(now())
}

model JobHealthScore {
  id         String   @id @default(cuid())
  jobId      String   @unique
  job        Job      @relation(fields: [jobId], references: [id])
  score      Int
  band       String // GREEN | YELLOW | RED
  factors    Json
  computedAt DateTime @default(now())
}

// Milestone 9 — weekly AI business insight reports. periodStart/periodEnd
// are explicit columns (not folded into `data`) so history can be queried
// without touching the Json blob; `data` holds the rest of the digest that
// fed the narrative in `summary`.
model InsightReport {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  periodStart    DateTime
  periodEnd      DateTime
  summary        String
  data           Json
  createdAt      DateTime @default(now())

  @@index([organisationId, createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  userId         String?
  action         String
  resource       String
  resourceId     String?
  before         Json?
  after          Json?
  ip             String?
  createdAt      DateTime @default(now())
}

model PortalToken {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  token      String   @unique
  scope      String[]
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model PendingAITask {
  id        String   @id @default(cuid())
  type      String
  refId     String
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Certifications & records (insurance, CSCS, DBS, accreditations, training)
// ---------------------------------------------------------------------------

enum CertOwnerType {
  BUSINESS
  PERSON
}

model Certification {
  id             String  @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  name     String
  // Plain String, not a Postgres enum -- deliberately kept flexible/
  // extendable per the brief. src/validators/certification.ts curates a
  // suggestion list (INSURANCE, CSCS, DBS, ACCREDITATION, TRAINING, OTHER)
  // for the picker, same pattern as MediaFile.category's document
  // categories in validators/media.ts, but any free text is accepted so a
  // new category never needs a migration.
  category String

  ownerType CertOwnerType
  // Required when ownerType is PERSON, null when BUSINESS -- enforced in
  // certificationSchema.refine() at the application layer, since Prisma
  // can't express "required when a sibling column has value X" at the DB
  // level.
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  issueDate  DateTime?
  expiryDate DateTime
  reference  String?
  // Storage path in the private bucket (SUPABASE_STORAGE_BUCKET), resolved
  // to a signed URL at read time -- see resolveFileUrl in
  // certification.service.ts, same pattern as MediaFile.url in
  // media.service.ts.
  fileUrl String?
  notes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Soft delete -- mirrors Customer.deletedAt / Job.deletedAt. Admin-only,
  // confirmed, per the brief -- enforced in the delete action, not here.
  deletedAt   DateTime?
  deletedById String?

  @@index([organisationId, expiryDate])
  @@index([organisationId, deletedAt])
}

// ---------------------------------------------------------------------------
// Property & Room Tracker (hotel groups -> properties -> rooms -> works
// history). This is a separate concept from the Property model above, which
// is a single job-site address hung off exactly one Customer and used by
// Job/Enquiry -- HotelProperty is a hospitality-specific tracking unit (an
// estate of many bathrooms worked repeatedly over years) with its own
// pricing, sealant, and site-contact fields, and its customerId link is
// optional (a prospect hotel can be tracked before it's ever invoiced). It's
// named HotelProperty rather than Property purely to avoid the model-name
// clash -- it still reuses the real Customer and Job models via optional
// relations rather than inventing parallel concepts for either.
// ---------------------------------------------------------------------------

model HotelGroup {
  id             String  @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  name           String
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  notes          String?
  properties     HotelProperty[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Soft delete -- mirrors Customer.deletedAt / Job.deletedAt. deletedById is
  // a plain scalar (no relation), same convention as Job.deletedById.
  // Deleting a group never cascades -- its properties survive untouched,
  // just rebucketed under "Independent" once the group stops matching any
  // deletedAt: null query.
  deletedAt   DateTime?
  deletedById String?

  @@index([organisationId, name])
}

enum BathroomType {
  FULL_BATH
  SHOWER_ONLY
  BATH_ONLY
}

model HotelProperty {
  id             String  @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  hotelGroupId   String?
  hotelGroup     HotelGroup? @relation(fields: [hotelGroupId], references: [id])
  // Optional -- ties the property to the Customer actually invoiced, once
  // one exists. Left null for a prospect hotel that's being tracked (or
  // quoted) before any commercial relationship is recorded.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  name         String
  addressLine1 String
  town         String?
  region       String?
  postcode     String

  // Cached Mapbox geocode result, same pattern as Property.latitude/
  // longitude above -- set once and reused, see ensureHotelPropertyGeocoded
  // in hotel-property.service.ts.
  latitude  Float?
  longitude Float?

  // Total rooms in the hotel, vs. rooms actually tracked (rooms.length) --
  // sizes the remaining untracked opportunity on the property page.
  totalBedrooms Int?

  siteContactName  String?
  siteContactRole  String?
  siteContactPhone String?
  siteContactEmail String?
  accessNotes      String?

  sealantBrand        String?
  sealantColour       String?
  sealantTubePriceGbp Decimal? @db.Decimal(10, 2)
  // Per-property price overrides -- fall back to the app defaults
  // (DEFAULT_PRICE_FULL_BATH_GBP / DEFAULT_PRICE_SHOWER_ONLY_GBP in
  // room.service.ts) when null, so a premium colour-match property can be
  // priced higher without touching the global defaults. BATH_ONLY rooms are
  // priced the same as priceFullBathGbp -- see roomPriceGbp() for why.
  priceFullBathGbp   Decimal? @db.Decimal(10, 2)
  priceShowerOnlyGbp Decimal? @db.Decimal(10, 2)

  resealIntervalMonths Int @default(36)

  notes String?
  rooms Room[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Soft delete -- mirrors Property.deletedAt. Never cascades: rooms and
  // their works history survive untouched, only the property's own
  // visibility (index/group/due-list pages) is hidden.
  deletedAt   DateTime?
  deletedById String?

  @@index([organisationId, hotelGroupId])
  @@index([organisationId, region, name])
}

enum RoomStatus {
  NOT_STARTED
  SCHEDULED
  DONE
  NO_ACCESS
  SNAG
}

model Room {
  id         String        @id @default(cuid())
  propertyId String
  property   HotelProperty @relation(fields: [propertyId], references: [id])

  // String, not int -- hotels number rooms "12a", "G04", "Suite 2".
  roomNumber   String
  // A label, not a relation -- "Ground", "1", "Annexe" -- deliberately no
  // Floor table (see the property page's floor grouping, done with a plain
  // groupBy over this string).
  floor        String?
  bathroomType BathroomType @default(FULL_BATH)
  status       RoomStatus   @default(NOT_STARTED)
  // Denormalised from the most recent completing visit (see
  // markRoomDone in room.service.ts) so the reseal-due query stays a cheap
  // scalar comparison instead of a correlated subquery per room.
  lastCompletedAt DateTime?
  // Preserves entry order within a floor (bulk-generated rooms keep the
  // order they were typed in, e.g. "101-124").
  sortIndex Int     @default(0)
  notes     String?

  visits RoomVisit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Soft delete -- same convention as HotelProperty.deletedAt. Visit history
  // is never deleted through normal UI even if the room record itself is.
  deletedAt   DateTime?
  deletedById String?

  // A hotel never reuses a room number, so this is the natural key. Note
  // this constraint applies regardless of deletedAt -- a soft-deleted room's
  // number can't be reused by a fresh row; that's an acceptable edge case
  // (restore the old room instead) rather than the far more complex
  // deletedAt-partial-unique-index alternative.
  @@unique([propertyId, roomNumber])
  @@index([propertyId, floor, sortIndex])
  @@index([propertyId, status])
}

enum RoomWorkType {
  CUT_OUT_AND_RESEAL
  NEW_APPLICATION
  GROUT_STEAM
  SNAG_RETURN
  SURVEY
}

// The works history -- a room holds many visits, never a single "date done"
// field. A hotel gets resealed repeatedly over the years, and overwriting a
// date would destroy the history that makes the reseal-due list possible.
model RoomVisit {
  id     String @id @default(cuid())
  roomId String
  room   Room   @relation(fields: [roomId], references: [id])
  // Optional -- ties a block of rooms to the Job they were invoiced under,
  // reusing the existing Job model rather than inventing a parallel one.
  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id])

  visitDate DateTime
  workType  RoomWorkType

  linearMetres Decimal? @db.Decimal(8, 2)
  // Snapshot of the price actually charged at the time -- deliberately never
  // recomputed from the property's current prices, so historical visits stay
  // accurate even after a property's rates change later.
  priceGbp      Decimal? @db.Decimal(10, 2)
  sealantBrand  String?
  sealantColour String?
  tubesUsed     Decimal? @db.Decimal(6, 2)
  operative     String?
  notes         String?

  photos RoomVisitPhoto[]

  createdAt DateTime @default(now())

  @@index([roomId, visitDate])
}

enum RoomVisitPhotoKind {
  BEFORE
  AFTER
}

model RoomVisitPhoto {
  id          String    @id @default(cuid())
  roomVisitId String
  roomVisit   RoomVisit @relation(fields: [roomVisitId], references: [id], onDelete: Cascade)
  // Private bucket (SUPABASE_STORAGE_BUCKET), served via a signed URL from
  // the existing storage helper -- see src/lib/storage/supabase.ts.
  storagePath String
  kind        RoomVisitPhotoKind
  caption     String?
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// PDF plan measuring tool ("takeoffs") -- linear-metre takeoffs measured off
// a floor-plan PDF, priced per item, that can feed straight into the
// existing quote builder. No area/m2 anywhere in this feature by design --
// the business quotes in linear metres only.
// ---------------------------------------------------------------------------

model ScalePreset {
  id             String  @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  // Label shown in the picker, e.g. "1:50". ratio is the N in 1:N -- always
  // a whole number in practice (architectural scales are never fractional).
  label String
  ratio Int

  createdAt DateTime @default(now())

  @@unique([organisationId, label])
  @@index([organisationId])
}

model Takeoff {
  id             String  @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  name String

  // Storage path in the private bucket, resolved to a signed URL at read
  // time -- same pattern as Certification.fileUrl.
  pdfFileUrl String
  pageCount  Int?

  // Optional on all three -- a takeoff can be a standalone measurement, or
  // attached to the customer it's for (so it's filed under that company in
  // Documents), and/or to the job/quote it was measured for.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  jobId      String?
  job        Job?      @relation(fields: [jobId], references: [id])
  quoteId    String?
  quote      Quote?    @relation(fields: [quoteId], references: [id])

  // The single canonical scale factor -- PDF points (72 per inch, the fixed
  // physical unit pdf.js renders against) of paper per real-world metre.
  // Set either from a ratio (scaleRatioLabel, e.g. "1:50", converted) or
  // from a calibration line (back-solved from a drawn line + a typed real
  // length), but always stored this one way so measurement math never
  // needs to know which method set it, and recomputes correctly at any
  // zoom. See resolvePointsPerMetre in src/validators/takeoff.ts.
  pointsPerMetre  Float
  scaleRatioLabel String?

  items TakeoffItem[]
  files TakeoffFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Soft delete -- mirrors Certification.deletedAt. Items and measurements
  // are not independently meaningful records (unlike the takeoff itself),
  // so they cascade with it at the DB level -- see TakeoffItem.
  deletedAt   DateTime?
  deletedById String?

  @@index([organisationId, deletedAt])
  @@index([customerId])
}

model TakeoffItem {
  id        String  @id @default(cuid())
  takeoffId String
  takeoff   Takeoff @relation(fields: [takeoffId], references: [id], onDelete: Cascade)

  name String
  // Hex colour (e.g. "#3C2263") -- drawn on the plan in this colour and
  // shown as a swatch in the side panel.
  colour String
  // Per-metre rate for THIS takeoff -- defaulted from the rate card when
  // created, but a snapshot from then on so a saved takeoff stays
  // reproducible even if the rate card changes later (same reasoning as
  // RoomVisit.priceGbp).
  pricePerMetre Decimal @db.Decimal(10, 2)
  sortOrder     Int     @default(0)

  measurements TakeoffMeasurement[]

  createdAt DateTime @default(now())

  @@index([takeoffId, sortOrder])
}

enum TakeoffMeasurementType {
  LENGTH
  CHAIN
}

model TakeoffMeasurement {
  id            String      @id @default(cuid())
  takeoffItemId String
  takeoffItem   TakeoffItem @relation(fields: [takeoffItemId], references: [id], onDelete: Cascade)

  // Which file (of the takeoff's possibly several) this measurement's
  // pageNumber refers to -- added when a drawing could hold more than one
  // PDF (floor plans + elevations, etc). Nullable as a safety net: treat a
  // null here as "the takeoff's first file" in code, same as the brief --
  // every row that existed before this column was added was backfilled to
  // point at its takeoff's one pre-existing file (see this migration's
  // data backfill), so in practice this should only ever be null for a
  // row some future bug created without setting it.
  takeoffFileId String?
  takeoffFile   TakeoffFile? @relation(fields: [takeoffFileId], references: [id])

  pageNumber Int
  type       TakeoffMeasurementType
  // [{x,y}, ...] in PDF page-point space (zoom-independent -- see the
  // comment on Takeoff.pointsPerMetre above) -- 2 points for LENGTH, 2 or
  // more for CHAIN.
  points Json
  computedMetres Decimal @db.Decimal(10, 2)
  label          String?

  createdAt DateTime @default(now())

  @@index([takeoffItemId])
  @@index([takeoffFileId])
}

// One PDF file within a drawing (Drawings Part 1 Step 4) -- a drawing can
// hold several (floor plans + elevations, etc), shown as tabs. Takeoff
// keeps its own pdfFileUrl/pageCount columns (now redundant but not
// dropped, additive-only); TakeoffFile is the source of truth for the
// file list from this migration on -- every pre-existing Takeoff got
// exactly one TakeoffFile backfilled from those columns, and every
// pre-existing TakeoffMeasurement was pointed at it (see this migration's
// data backfill, below the DDL).
model TakeoffFile {
  id             String  @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  takeoffId      String
  takeoff        Takeoff @relation(fields: [takeoffId], references: [id], onDelete: Cascade)

  name       String
  fileUrl    String
  pageCount  Int?
  // Optional per-file scale override -- a drawing's scale (Takeoff.
  // pointsPerMetre) applies to every file by default; set this only when
  // one file (e.g. an elevation) was drawn at a different scale than the
  // rest. Null means "use the takeoff's scale", not "zero".
  pointsPerMetre Float?
  sortOrder      Int     @default(0)

  measurements TakeoffMeasurement[]

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([takeoffId, deletedAt])
}

// The reusable rate card (Measuring tool Phase 2, Part B) -- set up once,
// picked from when adding an item to a takeoff. A TakeoffItem keeps its own
// copy of name/colour/pricePerMetre at the time it was added (unchanged from
// Phase 1), so editing or deleting a preset here never touches any existing
// takeoff or quote -- this table is only ever read from when creating a NEW
// TakeoffItem.
model TakeoffItemPreset {
  id             String  @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  name          String
  colour        String
  pricePerMetre Decimal @db.Decimal(10, 2)
  sortOrder     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Soft delete -- mirrors Certification.deletedAt. Uniqueness of `name`
  // among non-deleted rows is enforced in takeoff-rate-card.service.ts, not
  // as a DB constraint -- Prisma 5's schema syntax has no partial-unique-
  // index attribute, and a plain @@unique on (organisationId, name) would
  // wrongly block re-using a name after its old preset was soft-deleted.
  deletedAt   DateTime?
  deletedById String?

  @@index([organisationId, deletedAt])
}
